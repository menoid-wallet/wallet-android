# .env — the noid half's addresses and endpoints.
#
# Mirrors wallet-extension/.env one key at a time; only the prefix differs.
# Expo inlines EXPO_PUBLIC_* into the bundle at build time exactly as Plasmo
# did with PLASMO_PUBLIC_*, so these are BUILD-TIME constants — change one and
# you must rebuild, not just reload.
#
# Nothing secret belongs here. Every value is a public address or endpoint; the
# keys live encrypted in AsyncStorage and never leave the device.

EXPO_PUBLIC_API_BASE=https://wallet-hjud.onrender.com/api
# EXPO_PUBLIC_API_BASE=http://10.0.2.2:4000/api   # emulator → host

# Every chain was redeployed 2026-09-25: register() now stores the wallet's
# note-encryption public key ON-CHAIN next to its user commitment, so the app
# resolves a recipient from the chain alone. All six pools start empty.
# Full record: menoid/deploy.txt

# ─── Monad Testnet ────────────────────────────────────────────────────────────
EXPO_PUBLIC_MONAD_POOL_ADDRESS=0xf859f66DC79a1ea2ABA7832c22c82339E2a0D7c4

# ─── Sepolia Testnet ──────────────────────────────────────────────────────────
EXPO_PUBLIC_SEPOLIA_POOL_ADDRESS=0xD184D35c4Fe39ecC2aE86a9E34f0Fb9a40198E02

# ─── Base Sepolia Testnet ─────────────────────────────────────────────────────
EXPO_PUBLIC_BASE_SEPOLIA_POOL_ADDRESS=0x1597b5e8b6876d6b0d5610D74902E0659CDF9bd6

# ─── Solana Devnet ────────────────────────────────────────────────────────────
