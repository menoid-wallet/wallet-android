# .env — the noid half's addresses and endpoints.
#
# Mirrors wallet-extension/.env one key at a time; only the prefix differs.
# Expo inlines EXPO_PUBLIC_* into the bundle at build time exactly as Plasmo
# did with PLASMO_PUBLIC_*, so these are BUILD-TIME constants — change one and
# you must rebuild, not just reload.
#
# Nothing secret belongs here. Every value is a public address or endpoint; the
# keys live encrypted in AsyncStorage and never leave the device.

EXPO_PUBLIC_API_BASE=https://wallet-hjud.onrender.com/api
# PLASMO_PUBLIC_API_BASE=http://localhost:4000/api

# Pool addresses below were redeployed 2026-07-15 with the fixed deposit
# circuit (amount range checks). See menoid/deploy.txt for the full record.

# ─── Monad Testnet ────────────────────────────────────────────────────────────
EXPO_PUBLIC_MONAD_POOL_ADDRESS=0x4327bD4A8DA693517766699e21109BF21764CB53

# ─── Sepolia Testnet ──────────────────────────────────────────────────────────
EXPO_PUBLIC_SEPOLIA_POOL_ADDRESS=0xEf758FB0606AaB7fbAf96F4772883B970e8436AE

# ─── Base Sepolia Testnet ─────────────────────────────────────────────────────
EXPO_PUBLIC_BASE_SEPOLIA_POOL_ADDRESS=0x768bE43037Be62Ca081F7ccBecf49795CF25CE43

# Solana / Sui / Aptos are UNCHANGED — their verifying keys were updated in
# place (program upgrade / reinitialize_vks), so the addresses still hold.

# ─── Solana Devnet ────────────────────────────────────────────────────────────
EXPO_PUBLIC_SOLANA_PROGRAM_ID=3wxDTqw42qqftiAcTZ6kLeNtepuSmB1mR1skrEcwD9SC
EXPO_PUBLIC_SOLANA_POOL_STATE_PDA=285h75BTpGyFUCPoyFucNZKVfPYVv8msDEaEceTTETZj

# ─── Sui Testnet ──────────────────────────────────────────────────────────────
